  b.append(icon, title, desc);
  $('characterList').appendChild(b);
  b.onclick = () => {
    selected = i;
    avatars.forEach((_, j) => $('char' + j).setAttribute('aria-pressed', i === j ? 'true' : 'false'));
  };
});

$('chooseCharacter').onclick = () => {
  characterReady = true;
  $('entry').hidden = true;
  $('portrait').textContent = avatars[selected].icon + ' ' + avatars[selected].name;
  initAudio();
  restart();
  broadcastState('move');
};

$('backLogin').onclick = () => {
  $('characterPage').hidden = true;
  $('loginPage').hidden = false;
};

$('logout').onclick = () => {
  running = false;
  paused = true;
  characterReady = false;
  student = null;
  monsters = [];
  $('entry').hidden = false;
  $('loginPage').hidden = false;
  $('characterPage').hidden = true;
  $('welcome').style.display = 'none';
  $('portrait').textContent = '캐릭터 선택 전';
  $('classInput').focus();
  updateSound();
};

$('soundToggle').onclick = () => {
  initAudio();
  const on = $('soundToggle').getAttribute('aria-pressed') !== 'true';
  $('soundToggle').setAttribute('aria-pressed', String(on));
  $('soundToggle').textContent = on ? '소리 끄기' : '소리 켜기';
  updateSound();
};

$('volume').oninput = updateSound;

document.addEventListener('visibilitychange', () => {
  if (document.hidden && running && !ended) {
    paused = true;
    $('pause').textContent = 'Resume';
  }
  updateSound();
});

try {
  if (!gl) {
    throw new Error('이 브라우저에서 WebGL을 사용할 수 없습니다. Chrome 또는 Edge에서 하드웨어 가속을 켜 주세요.');
  }
  initGL();
  buildTownMesh();
  updateHUD();
  requestAnimationFrame(tick);
} catch (e) {
  $('error').textContent = e.message;
  $('start').disabled = true;
}
</script>
</body>
</html>
