<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8"/>
<title>Treasure Town 3D — Realistic Edition</title>
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'none'; base-uri 'none'; form-action 'none'"/>
<style>
:root {
  --wrks-viz-font-family: Pretendard, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --wrks-viz-primary: #2563eb;
  --wrks-viz-bg: #ffffff;
  --wrks-viz-fg: #111827;
  --wrks-viz-border: #d1d5db;
  --wrks-viz-radius: 8px;
  --wrks-viz-space-1: 4px;
  --wrks-viz-space-2: 8px;
  --wrks-viz-space-3: 12px;
  --wrks-viz-space-4: 16px;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 12px;
  font-family: var(--wrks-viz-font-family);
  background: var(--wrks-viz-bg);
  color: var(--wrks-viz-fg);
}
h1 {
  font-size: 20px;
  margin: 0;
  letter-spacing: -0.02em;
}
.top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.badgeRow {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
#progress {
  font-weight: 700;
  font-size: 15px;
  padding: 4px 10px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  background: var(--wrks-viz-bg);
}
#roomBadge {
  font-size: 12px;
  font-weight: 600;
  padding: 4px 8px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  background: var(--wrks-viz-bg);
}
.scene {
  position: relative;
  height: 450px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  overflow: hidden;
  background: #0f172a;
  user-select: none;
}
canvas {
  width: 100%;
  height: 100%;
  display: block;
}
.overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
#labels {
  position: absolute;
  inset: 0;
  overflow: hidden;
}
.sign {
  position: absolute;
  transform: translate(-50%, -50%);
  background: rgba(20, 26, 35, 0.92);
  color: #f8fafc;
  padding: 2px 7px;
  border: 1.5px solid #cbd5e1;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
  border-radius: 3px;
  white-space: nowrap;
  pointer-events: none;
}
.sign.targetSign {
  border-color: #38bdf8;
  color: #e0f2fe;
}
.peerTag {
  position: absolute;
  transform: translate(-50%, -100%);
  background: rgba(15, 23, 42, 0.85);
  color: #ffffff;
  padding: 2px 6px;
  border: 1px solid #94a3b8;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  white-space: nowrap;
  pointer-events: none;
}
.hud {
  position: absolute;
  top: 10px;
  left: 10px;
  background: rgba(15, 23, 42, 0.82);
  color: #f8fafc;
  border: 1px solid rgba(203, 213, 225, 0.4);
  padding: 7px 10px;
  border-radius: 6px;
  font-size: 12.5px;
  max-width: 68%;
  line-height: 1.4;
}
#questionBanner {
  position: absolute;
  top: 52px;
  left: 10px;
  background: rgba(37, 99, 235, 0.9);
  color: #ffffff;
  border: 1px solid rgba(191, 219, 254, 0.6);
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 700;
}
#flash {
  position: absolute;
  inset: 0;
  border: 0 solid #dc2626;
  pointer-events: none;
}
#map {
  position: absolute;
  right: 10px;
  top: 10px;
  width: 172px;
  height: 124px;
  border: 1px solid rgba(203, 213, 225, 0.6);
  border-radius: 6px;
  background: rgba(15, 23, 42, 0.84);
  pointer-events: auto;
}
.navOverlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.hudBtn {
  pointer-events: auto;
  position: absolute;
  background: rgba(15, 23, 42, 0.48);
  color: #f8fafc;
  border: 1px solid rgba(248, 250, 252, 0.45);
  border-radius: 8px;
  padding: 10px 14px;
  font: inherit;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}
.hudBtn:hover {
  background: rgba(37, 99, 235, 0.68);
  border-color: #93c5fd;
}
.hudBtn:active {
  transform: scale(0.97);
}
.hudBtn .arrow {
  font-size: 18px;
  line-height: 1;
}
#hudLeft {
  left: 12px;
  top: 54%;
  transform: translateY(-50%);
}
#hudRight {
  right: 12px;
  top: 54%;
  transform: translateY(-50%);
}
.hudBottomGroup {
  position: absolute;
  bottom: 12px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 6px;
  align-items: flex-end;
  pointer-events: auto;
}
.hudBottomGroup .hudBtn {
  position: static;
}
.hudBtn.subBtn {
  padding: 8px 10px;
  font-size: 12px;
}
.panel {
  margin-top: 8px;
  padding: 10px 12px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  background: var(--wrks-viz-bg);
}
.row {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  margin: 6px 0;
  align-items: center;
}
button, select {
  font: inherit;
  font-size: 13px;
  padding: 8px 11px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: 4px;
  background: var(--wrks-viz-bg);
  color: var(--wrks-viz-fg);
  cursor: pointer;
}
button.primary {
  background: var(--wrks-viz-primary);
  color: #ffffff;
  border-color: var(--wrks-viz-primary);
}
button:disabled {
  opacity: 0.45;
  cursor: default;
}
#question {
  font-size: 18px;
  font-weight: 700;
}
#message {
  min-height: 22px;
  margin-top: 4px;
  font-size: 13.5px;
  font-weight: 500;
}
#hint {
  font-size: 13px;
  line-height: 1.5;
  color: var(--wrks-viz-primary);
  font-weight: 600;
  margin-top: 4px;
}
.small {
  font-size: 12px;
  margin: 4px 0;
  line-height: 1.5;
}
#welcome {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.82);
  pointer-events: auto;
}
.intro {
  max-width: 440px;
  padding: 20px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  background: var(--wrks-viz-bg);
  color: var(--wrks-viz-fg);
}
.intro h2 {
  margin-top: 0;
  font-size: 18px;
}
details {
  font-size: 12.5px;
  margin-top: 6px;
}
#places {
  line-height: 1.65;
  margin-top: 4px;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
}
[hidden] { display: none !important; }
#entry {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.88);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 14px;
  overflow: auto;
}
.entryCard {
  width: min(560px, 100%);
  max-height: 94vh;
  overflow: auto;
  padding: 22px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: var(--wrks-viz-radius);
  background: var(--wrks-viz-bg);
  color: var(--wrks-viz-fg);
}
#loginForm {
  display: grid;
  gap: 7px;
}
input {
  font: inherit;
  padding: 9px 10px;
  border: 1px solid var(--wrks-viz-border);
  border-radius: 4px;
  background: var(--wrks-viz-bg);
  color: var(--wrks-viz-fg);
}
#characterList {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
  margin: 10px 0;
}
.character {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 12px;
}
.character[aria-pressed="true"] {
  outline: 3px solid var(--wrks-viz-primary);
  outline-offset: -3px;
}
.characterIcon {
  font-size: 38px;
}
.jewel {
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
#danger {
  position: absolute;
  bottom: 74px;
  left: 12px;
  font-weight: 700;
  background: rgba(127, 29, 29, 0.92);
  color: #fef2f2;
  border: 1.5px solid #f87171;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 12.5px;
}
#portrait {
  font-size: 14px;
  font-weight: 600;
}
.soundRow {
  align-items: center;
}
#volume {
  width: 90px;
}
@media (max-width: 600px) {
  .scene { height: 360px; }
  #map { width: 126px; height: 92px; }
  .sign { font-size: 9.5px; }
  .hud { font-size: 11px; }
  .hudBtn { padding: 8px 10px; font-size: 11.5px; }
}
</style>
</head>
<body>
<section aria-label="로그인과 캐릭터 선택" id="entry">
  <div class="entryCard">
    <section id="loginPage">
      <h2>Treasure Town 3D — Realistic Edition</h2>
      <p class="small">반, 번호, 이름(및 선택 사항인 교사 입장 코드)을 입력하고 사실적인 3D 마을 탐험을 시작하세요.</p>
      <form id="loginForm">
        <label for="codeInput">교사 입장 코드 (선택 — 같은 코드 입력 시 함께 플레이)</label>
        <input autocomplete="off" id="codeInput" maxlength="20" placeholder="예: ENG5 (혼자 하려면 비워두세요)" value="ENG5"/>
        <label for="classInput">반</label>
        <input autocomplete="off" id="classInput" maxlength="20" placeholder="예: 5학년 2" required="" value="5학년 1"/>
        <label for="numberInput">번호</label>
        <input id="numberInput" max="999" min="1" placeholder="예: 12" required="" type="number" value="1"/>
        <label for="nameInput">이름</label>
        <input autocomplete="off" id="nameInput" maxlength="30" placeholder="이름" required="" value="홍길동"/>
        <p id="loginError" role="alert" class="small" style="color:#dc2626"></p>
        <button class="primary" type="submit">로그인 / Log in</button>
      </form>
      <p class="small">이 화면은 학생 정보 입력 화면입니다. 보물(💎) 입구에 닿으면 자동으로 획득되며, 귀신·괴물의 위치는 지도에서 숨겨집니다.</p>
    </section>
    <section hidden="" id="characterPage">
      <h2>Choose your character</h2>
      <p id="greeting"></p>
      <div id="characterList"></div>
      <div class="row">
        <button id="backLogin" type="button">뒤로</button>
        <button class="primary" id="chooseCharacter" type="button">선택하고 게임 시작</button>
      </div>
      <p class="small">1인칭 실사풍 3D 시점으로 진행되며, 선택한 캐릭터는 프로필과 지도 및 친구 화면에 표시됩니다.</p>
      <p class="small">무서운 실사풍 귀신·괴물과 근접 효과음이 등장합니다. 상단에서 소리를 끄거나 음량을 조절할 수 있습니다.</p>
    </section>
  </div>
</section>

<div class="top">
  <h1>Treasure Town 3D</h1>
  <div class="badgeRow">
    <div id="roomBadge">방 코드: 개인 탐험</div>
    <div id="progress">❤️❤️❤️ · 💎 0개</div>
  </div>
</div>

<div class="scene">
  <canvas aria-label="1인칭 실사풍 3D 마을 게임 화면" id="world"></canvas>
  <div class="overlay">
    <div id="labels"></div>
    <div class="hud" id="status">출발 위치: 마을 남서쪽 · 바라보는 방향: North</div>
    <div id="questionBanner">Where is the …?</div>
    <svg aria-label="마을 지도" id="map" role="img" viewBox="0 0 240 160"></svg>
    <div id="flash"></div>
    <div hidden="" id="danger" role="status">주의: 귀신·괴물이 1블록 이내에 있습니다!</div>
    <div class="navOverlay" aria-label="반투명 방향 이동 버튼">
      <button type="button" class="hudBtn" id="hudLeft" title="Turn left (←)">
        <span class="arrow">↶</span>
        <span>Turn left</span>
      </button>
      <button type="button" class="hudBtn" id="hudRight" title="Turn right (→)">
        <span class="arrow">↷</span>
        <span>Turn right</span>
      </button>
      <div class="hudBottomGroup">
        <button type="button" class="hudBtn" id="hudForward1" title="Go straight 1 block (↑)">
          <span class="arrow">↑</span>
          <span>Go straight</span>
        </button>
        <button type="button" class="hudBtn subBtn" id="hudForward2" title="Go straight 2 blocks">
          <span>↑ 2 blocks</span>
        </button>
        <button type="button" class="hudBtn subBtn" id="hudForward3" title="Go straight 3 blocks">
          <span>↑ 3 blocks</span>
        </button>
      </div>
    </div>
    <div id="welcome" style="display:none">
      <div class="intro">
        <h2>영어로 길을 찾아 보물을 모으세요</h2>
        <p class="small">실사풍 3D 그래픽으로 구현된 60개 건물과 거리를 탐험합니다. 보물(💎)이 있는 건물 입구에 닿으면 자동으로 점수가 올라가며, 보물은 획득할 때마다 새로운 장소에 무작위로 다시 나타나며, 원하는 만큼 계속 모을 수 있습니다.</p>
        <p class="small">화면의 반투명 방향 버튼(Turn left / Go straight / Turn right) 또는 키보드 화살표 키로 이동하세요.</p>
        <button class="primary" id="start" type="button">Start game</button>
        <div class="small" id="error"></div>
      </div>
    </div>
  </div>
</div>

<div class="panel">
  <div class="row soundRow">
    <span id="portrait">캐릭터 선택 전</span>
    <button aria-pressed="true" id="soundToggle" type="button">소리 끄기</button>
    <label for="volume" class="small">음량</label>
    <input id="volume" max="100" min="0" type="range" value="25"/>
    <span class="small" id="soundState">게임 시작 후 소리가 활성화됩니다.</span>
    <button id="logout" type="button">로그아웃</button>
  </div>
  <div id="question">Where is the …?</div>
  <div class="row">
    <button class="move" data-blocks="1" type="button">Go straight 1 block.</button>
    <button class="move" data-blocks="2" type="button">Go straight 2 blocks.</button>
    <button class="move" data-blocks="3" type="button">Go straight 3 blocks.</button>
    <button id="left" type="button">Turn left.</button>
    <button id="right" type="button">Turn right.</button>
    <button class="primary" id="search" type="button">Search here</button>
    <button id="hintBtn" type="button">길 안내 힌트</button>
    <button id="pause" type="button">Pause</button>
    <button id="reset" type="button">Restart</button>
  </div>
  <div aria-live="polite" id="message" role="status">로그인한 뒤 캐릭터를 선택해 주세요.</div>
  <div id="hint"></div>
  <p class="small">키보드: ↑ = 1블록 직진 · ← / → = 회전 · Space = 확인 · P = 일시정지. 보물(💎)이 있는 파란 입구에 닿으면 자동으로 획득됩니다. 전체지도에서 괴물·귀신의 위치는 표시되지 않습니다.</p>
  <details>
    <summary>장소 60개와 영어 길 안내 핵심 표현 보기</summary>
    <div id="places"></div>
    <p class="small">Where is the (place)? / Go straight (number) blocks. / Turn left. / Turn right. / It's next to the (place). / It's on your left/right.</p>
  </details>
</div>

<div class="sr-only">
  <table>
    <caption>Treasure Town 3D 게임 정보</caption>
    <thead>
      <tr><th>항목</th><th>값</th></tr>
    </thead>
    <tbody>
      <tr><td>장소 수</td><td>60개 건물</td></tr>
      <tr><td>보물 목표</td><td>무제한 랜덤 생성 (💎)</td></tr>
      <tr><td>초기 목숨</td><td>3개 (❤️❤️❤️)</td></tr>
      <tr><td>그래픽 스타일</td><td>실사풍 3D 벽돌·유리·아스팔트·가로수·귀신·괴물 셰이더</td></tr>
    </tbody>
  </table>
</div>

<script>
'use strict';
const names = [
  "museum", "market", "hospital", "library", "school", "bank", "post office", "police station", "fire station", "bakery",
  "restaurant", "toy shop", "bookstore", "supermarket", "cinema", "cafe", "flower shop", "pet shop", "music shop", "sports center",
  "swimming pool", "bus station", "train station", "hotel", "city hall", "park office", "art gallery", "science center", "aquarium", "zoo entrance",
  "candy shop", "ice cream shop", "pizza shop", "burger shop", "tea house", "clothes shop", "shoe shop", "gift shop", "computer shop", "phone shop",
  "furniture shop", "bicycle shop", "car garage", "dental clinic", "pharmacy", "health center", "community center", "dance studio", "music school", "language school",
  "kindergarten", "college", "university", "shopping mall", "department store", "food court", "farm shop", "garden center", "observatory", "theater"
];

const places = names.map((name, i) => ({
  name,
  x: 4 + (i % 10) * 4,
  z: 4 + Math.floor(i / 10) * 4,
  doorX: 2 + (i % 10) * 4,
  doorZ: 6 + Math.floor(i / 10) * 4,
  height: 2.95 + (i % 3) * 0.72 + ((i * 7) % 2) * 0.35,
  style: i % 5
}));

const $ = id => document.getElementById(id);
$('places').textContent = names.join(' · ');

const canvas = $('world');
const gl = canvas.getContext('webgl', { antialias: true, alpha: false });

let running = false, paused = false, ended = false;
let lives = 3, score = 0, yaw = 0, px = 2, pz = 26;
let move = null, turn = null, invincible = 0, last = 0, target = 0;
let order = [], monsters = [], hintOn = false;
let student = null, selected = 0, characterReady = false, roomCode = '';
let peers = {};
let bc = null;

const TAU = Math.PI * 2;
const avatars = [
  { name: 'Explorer', icon: '🧑‍🚀', color: '#3b82f6', rgb: [0.23, 0.51, 0.96], desc: '파란 탐험가' },
  { name: 'Wizard', icon: '🧙', color: '#8b5cf6', rgb: [0.55, 0.36, 0.96], desc: '보라 마법사' },
  { name: 'Detective', icon: '🕵️', color: '#d97706', rgb: [0.85, 0.47, 0.02], desc: '갈색 탐정' },
  { name: 'Robot', icon: '🤖', color: '#10b981', rgb: [0.06, 0.73, 0.51], desc: '초록 로봇' }
];

// Procedural Realistic Shader
// uMat:
// 0 = solid/painted architectural stone/metal
// 1 = realistic brick/stone wall with mortar & weathering
// 2 = reflective window glass with curtains & interior warm light
// 3 = asphalt road & concrete sidewalk pavers
// 4 = roof shingles / striped fabric awning
// 5 = natural foliage & tree bark
// 6 = haunted ghost shroud & pallid skin
// 7 = monster scaly muscle hide
// 8 = realistic twilight sky dome with clouds & distant mountains
// 9 = glowing lantern / treasure crystal / shadow
const vertexShaderSrc = `
attribute vec3 aPosition;
attribute vec3 aNormal;
attribute vec3 aColor;
attribute float aMat;

uniform mat4 uVP;
uniform vec3 uOffset;
uniform vec3 uScale;
uniform vec3 uColor;
uniform float uMatOverride;
uniform float uRotY;

varying vec3 vNormal;
varying vec3 vPos;
varying vec3 vLocal;
varying vec3 vColor;
varying float vMat;

void main() {
  vec3 scaled = aPosition * uScale;
  float c = cos(uRotY);
  float s = sin(uRotY);
  vec3 rotated = vec3(scaled.x * c + scaled.z * s, scaled.y, -scaled.x * s + scaled.z * c);
  vec3 worldPos = rotated + uOffset;
