    // Deep hollow eye sockets + glowing pinpoint eerie pupils + dark screaming mouth
    for (let side of [-1, 1]) {
      const ex = hx + fx * 0.19 + rx * 0.11 * side;
      const ez = hz + fz * 0.19 + rz * 0.11 * side;
      drawEllipsoidDynamic(ex, hy + 0.03, ez, 0.14, 0.13, 0.11, abyssDark, 0, faceYaw);
