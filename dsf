    // Forward-leaning gaunt neck & anatomical skull/head
    const hx = m.x + fx * 0.14, hy = 2.02 + bob, hz = m.z + fz * 0.14;
    drawEllipsoidDynamic(hx - fx * 0.05, hy - 0.24, hz - fz * 0.05, 0.20, 0.28, 0.20, pallidSkin, 6, faceYaw);
    drawEllipsoidDynamic(hx, hy, hz, 0.46, 0.58, 0.44, pallidSkin, 6, faceYaw);
    // Gaunt cheekbones & sunken jaw
