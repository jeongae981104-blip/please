// Dynamic primitive drawing helpers
function drawBoxDynamic(x, y, z, w, h, d, color, mat = 0, rotY = 0) {
  bindVertexLayout(unitCubeBuffer);
  gl.uniform3f(loc.uOffset, x, y, z);
  gl.uniform3f(loc.uScale, w, h, d);
  gl.uniform3fv(loc.uColor, color);
  gl.uniform1f(loc.uMatOverride, mat);
  gl.uniform1f(loc.uRotY, rotY);
  gl.drawArrays(gl.TRIANGLES, 0, 36);
}

function drawEllipsoidDynamic(x, y, z, w, h, d, color, mat = 0, rotY = 0) {
  bindVertexLayout(unitSphereBuffer);
  gl.uniform3f(loc.uOffset, x, y, z);
  gl.uniform3f(loc.uScale, w, h, d);
  gl.uniform3fv(loc.uColor, color);
  gl.uniform1f(loc.uMatOverride, mat);
  gl.uniform1f(loc.uRotY, rotY);
  gl.drawArrays(gl.TRIANGLES, 0, sphereVertexCount);
}

// Realistic Scary Ghost & Articulated Monster Renderer
function drawEnemy(m, i, time) {
  const isGhost = i % 2 === 0;
  const dx = px - m.x, dz = pz - m.z;
  const dist = Math.hypot(dx, dz) || 1;
  const fx = dx / dist, fz = dz / dist; // Unit vector facing player
  const rx = fz, rz = -fx;              // Right vector perpendicular to facing
  const faceYaw = Math.atan2(fx, fz);

  // Ground contact shadow beneath enemy
  drawEllipsoidDynamic(m.x, 0.055, m.z, 1.15, 0.02, 1.15, [0.05, 0.05, 0.07], 10, 0);

  if (isGhost) {
    // HAUNTED GHOST (창백하고 소름 끼치는 실사풍 원귀)
    const bob = Math.sin(time * 0.0038 + i * 1.7) * 0.09;
    const sway = Math.sin(time * 0.0024 + i) * 0.05;
    const shroudCol = [0.74, 0.78, 0.76];
    const darkShroud = [0.42, 0.47, 0.45];
    const pallidSkin = [0.68, 0.73, 0.69];
    const abyssDark = [0.03, 0.03, 0.04];

    // Tattered flowing burial shroud (torso & layered skirt folds)
    drawEllipsoidDynamic(m.x + rx * sway, 1.18 + bob, m.z + rz * sway, 0.66, 1.52, 0.50, shroudCol, 6, faceYaw);
    drawEllipsoidDynamic(m.x - fx * 0.06, 1.42 + bob, m.z - fz * 0.06, 0.74, 0.92, 0.54, darkShroud, 6, faceYaw);

    // Protruding skeletal rib/collarbone ridges
    for (let r = 0; r < 3; r++) {
      let ry = 1.38 + r * 0.11 + bob;
      drawEllipsoidDynamic(m.x + fx * 0.22, ry, m.z + fz * 0.22, 0.38 - r * 0.04, 0.05, 0.16, pallidSkin, 6, faceYaw);
    }

    // Floating tattered cloth strips at bottom hem
    for (let k = 0; k < 12; k++) {
      const a = k * TAU / 12 + time * 0.0012;
      const flutter = Math.sin(time * 0.005 + k * 1.3) * 0.06;
      const sx = m.x + Math.cos(a) * (0.28 + flutter);
