      // Long tangled black hair strands cascading over face & shoulders
      for (let h = 0; h < 5; h++) {
        const hOff = 0.16 + h * 0.035;
        const hSway = Math.sin(time * 0.004 + h + side) * 0.04;
        drawEllipsoidDynamic(
          hx + rx * (hOff * side + hSway) - fx * (0.02 * h),
