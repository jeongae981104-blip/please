// Check if line of sight from camera (px, pz) to sign (sx, sz) is blocked by another building
function isSignOccluded(sx, sz, ownerPlace) {
  const dx = sx - px, dz = sz - pz;
  const lenSq = dx * dx + dz * dz;
  if (lenSq < 0.01) return false;
  for (let i = 0; i < places.length; i++) {
    const b = places[i];
    if (b === ownerPlace) continue;
    // Quick bounding distance check
    const bx = b.x - px, bz = b.z - pz;
    const t = (bx * dx + bz * dz) / lenSq;
    if (t <= 0.02 || t >= 0.96) continue;
    const cx = px + t * dx, cz = pz + t * dz;
    if (Math.abs(cx - b.x) < 1.42 && Math.abs(cz - b.z) < 1.42) {
      return true;
    }
  }
  return false;
}

function project(x, y, z) {
  let v = [x, y, z, 1], q = [0, 0, 0, 0];
  for (let r = 0; r < 4; r++) {
    for (let c = 0; c < 4; c++) q[r] += vp[c * 4 + r] * v[c];
  }
  if (q[3] <= 0.1) return null;
  return {
    x: (q[0] / q[3] * 0.5 + 0.5) * canvas.clientWidth,
    y: (-0.5 * q[1] / q[3] + 0.5) * canvas.clientHeight,
    w: q[3]
  };
}

function draw(time) {
  let dpr = Math.min(window.devicePixelRatio || 1, 2);
  let w = Math.round(canvas.clientWidth * dpr);
  let h = Math.round(canvas.clientHeight * dpr);
  if (canvas.width !== w || canvas.height !== h) {
    canvas.width = w;
    canvas.height = h;
  }
  gl.viewport(0, 0, w, h);
  gl.clearColor(0.18, 0.24, 0.36, 1);
  gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

  vp = matmul(projection(w / h), view());
  gl.uniformMatrix4fv(loc.uVP, false, vp);
  gl.uniform3f(loc.uEye, px, 1.38, pz);
  gl.uniform1f(loc.uTime, time * 0.001);

  // 1. Render Sky Dome around viewer
  gl.depthMask(false);
  drawBoxDynamic(px, 1.38, pz, 110, 110, 110, [1, 1, 1], 8, 0);
  gl.depthMask(true);

  // 2. Render Batched Realistic Town & 60 Buildings in 1 Draw Call
  bindVertexLayout(townBuffer);
  gl.uniform3f(loc.uOffset, 0, 0, 0);
  gl.uniform3f(loc.uScale, 1, 1, 1);
  gl.uniform1f(loc.uMatOverride, -1.0);
  gl.uniform1f(loc.uRotY, 0.0);
  gl.drawArrays(gl.TRIANGLES, 0, townVertexCount);

  // 3. Render Active 3D Glowing Treasure Crystal & Pedestal at Target Building Door
  const tp = places[target];
  if (running && !ended && tp) {
    const floatY = 0.65 + Math.sin(time * 0.004) * 0.10;
    drawBoxDynamic(tp.doorX, 0.14, tp.doorZ, 0.42, 0.16, 0.42, [0.22, 0.58, 0.98], 9, time * 0.002);
    drawEllipsoidDynamic(tp.doorX, floatY, tp.doorZ, 0.32, 0.44, 0.32, [0.35, 0.88, 1.0], 9, time * 0.003);
  }

  // 4. Render Realistic Ghosts & Articulated Monsters
  monsters.forEach((m, i) => drawEnemy(m, i, time));

  // 5. Render Same-Code Room Peers (if any)
  Object.values(peers).forEach(peer => {
    if (performance.now() - peer.ts < 8000) {
      drawPeerAvatar(peer, time);
    }
  });

  // 6. Update Wall-Mounted Sign Overlays (with occlusion culling)
  signs.forEach(s => {
    const outward = [pz > s.p.z + 1.3, px > s.p.x + 1.3, pz < s.p.z - 1.3, px < s.p.x - 1.3][s.side];
    if (!outward) {
      s.el.style.display = 'none';
      return;
    }
    const q = project(s.x, 2.36, s.z);
    const visible = q && q.w < 22 && q.x > 8 && q.x < canvas.clientWidth - 8 && q.y > 8 && q.y < canvas.clientHeight - 8 && !isSignOccluded(s.x, s.z, s.p);
    s.el.style.display = visible ? 'block' : 'none';
    if (visible) {
      s.el.style.left = q.x + 'px';
      s.el.style.top = q.y + 'px';
      s.el.style.fontSize = Math.max(8.5, Math.min(14.5, 130 / q.w)) + 'px';
      s.el.classList.toggle('targetSign', s.idx === target);
    }
  });

  // 7. Update 💎 Jewel Icon at Target Entrance
  if (tp) {
    const q = project(tp.doorX, 0.72 + Math.sin(time * 0.004) * 0.09, tp.doorZ);
    const visible = running && !ended && q && q.w < 14 && q.x > 0 && q.x < canvas.clientWidth && q.y > 0 && q.y < canvas.clientHeight && !isSignOccluded(tp.doorX, tp.doorZ, tp);
    jewel.style.display = visible ? 'block' : 'none';
    if (visible) {
      jewel.style.left = q.x + 'px';
      jewel.style.top = q.y + 'px';
      jewel.style.fontSize = Math.min(46, Math.max(18, 115 / q.w)) + 'px';
    }
  }

  drawMap();
}

// Minimap (Monsters/Ghosts are intentionally hidden per teacher requirement)
function drawMap() {
  let s = '', sc = 4.8;
  for (let x = 2; x <= 42; x += 4) {
    s += '<path d="M ' + (x * sc + 10) + ' 10 V 145" stroke="#334155" stroke-width="5"/>';
  }
  for (let z = 2; z <= 26; z += 4) {
    s += '<path d="M 10 ' + (z * sc + 8) + ' H 220" stroke="#334155" stroke-width="5"/>';
  }
  places.forEach((p, i) => {
    const isTarget = running && !ended && i === target;
    s += '<rect x="' + (p.x * sc + 4) + '" y="' + (p.z * sc + 2) + '" width="12" height="12" fill="' + (isTarget ? '#1e3a8a' : '#1e293b') + '" stroke="' + (isTarget ? '#60a5fa' : '#64748b') + '"/>';
    s += '<text x="' + (p.x * sc + 10) + '" y="' + (p.z * sc + 10.5) + '" font-size="5.8" text-anchor="middle" fill="#f8fafc">' + (i + 1) + '</text>';
    // Blue entrance dot
    s += '<rect x="' + (p.doorX * sc + 8.5) + '" y="' + (p.doorZ * sc + 6.5) + '" width="3" height="3" fill="#38bdf8"/>';
  });
  // Peer dots on map
  Object.values(peers).forEach(peer => {
    if (performance.now() - peer.ts < 8000) {
      const av = avatars[peer.avatar || 0] || avatars[0];
      s += '<circle cx="' + (peer.x * sc + 10) + '" cy="' + (peer.z * sc + 8) + '" r="3.2" fill="' + av.color + '" stroke="#ffffff" stroke-width="0.8"/>';
    }
  });
  // Player position & direction arrow
  const x = px * sc + 10, z = pz * sc + 8;
  const col = avatars[selected].color;
  s += '<circle cx="' + x + '" cy="' + z + '" r="4.2" fill="' + col + '" stroke="#ffffff" stroke-width="1"/>';
  s += '<path d="M ' + x + ' ' + z + ' l ' + (Math.sin(yaw) * 9) + ' ' + (-Math.cos(yaw) * 9) + '" stroke="#ffffff" stroke-width="2"/>';
  $('map').innerHTML = s;
}

function nearestNode(x, z) {
  return {
    x: Math.max(2, Math.min(42, 2 + Math.round((x - 2) / 4) * 4)),
    z: Math.max(2, Math.min(26, 2 + Math.round((z - 2) / 4) * 4))
  };
}

function neighbors(x, z) {
  return [[x - 4, z], [x + 4, z], [x, z - 4], [x, z + 4]].filter(a => a[0] >= 2 && a[0] <= 42 && a[1] >= 2 && a[1] <= 26);
}

function monsterNext(m) {
  let ns = neighbors(m.tx, m.tz);
  let opts = ns.filter(a => a[0] !== m.oldx || a[1] !== m.oldz);
  if (!opts.length) opts = ns;
  let n = opts[Math.floor(Math.random() * opts.length)];
  m.oldx = m.tx;
  m.oldz = m.tz;
  m.x = m.tx;
  m.z = m.tz;
  m.tx = n[0];
  m.tz = n[1];
}

function spawnMonster(x, z) {
  let m = { x, z, tx: x, tz: z, oldx: -1, oldz: -1 };
  monsterNext(m);
  return m;
}

function setMessage(s) {
  $('message').textContent = s;
}

function updateHUD() {
  let heading = ['North', 'East', 'South', 'West'][((Math.round(yaw / (Math.PI / 2)) % 4) + 4) % 4];
  $('progress').textContent = '❤️'.repeat(lives) + '🤍'.repeat(3 - lives) + ' · 💎 ' + score + '개';
  const peerCount = Object.values(peers).filter(p => performance.now() - p.ts < 8000).length;
  $('roomBadge').textContent = roomCode
    ? '방 코드: ' + roomCode + (peerCount > 0 ? ' (친구 ' + peerCount + '명 접속 중)' : '')
    : '방 코드: 개인 탐험';
  $('status').textContent = (student ? student.className + '반 ' + student.number + '번 ' + student.name + ' · ' + avatars[selected].name + ' · ' : '')
    + '방향: ' + heading + ' · 적 속도: ' + (1 + score * 0.18).toFixed(2) + '배'
    + (invincible > 0 ? ' · 잠시 무적 상태입니다.' : '');
  const qText = ended
    ? 'Game over. Try again!'
    : 'Where is the ' + places[target].name + '?';
  $('question').textContent = qText;
  $('questionBanner').textContent = qText;
}

function nextTreasureTarget() {
  let next = Math.floor(Math.random() * places.length);
  if (places.length > 1 && next === target) {
    next = (next + 1 + Math.floor(Math.random() * (places.length - 1))) % places.length;
  }
  return next;
}

function collectTreasure() {
  if (!running || paused || ended) return;
  score++;
  playChime();
  broadcastState('collect', { target });
  target = nextTreasureTarget();
  setMessage('💎 보물을 획득했습니다! 지금까지 ' + score + '개를 모았습니다. 다음 보물이 ' + places[target].name + '에 나타났습니다!');
  updateHUD();
  if (hintOn) showHint();
}

function checkAutoCollect() {
  if (!running || paused || ended) return;
  const p = places[target];
  if (p && Math.hypot(px - p.doorX, pz - p.doorZ) <= 1.22) {
    collectTreasure();
  }
}

function restart() {
  if (!student || !characterReady) return;
  initAudio();
  px = 2;
  pz = 26;
  yaw = 0;
  lives = 3;
  score = 0;
  move = null;
  turn = null;
  invincible = 0;
  ended = false;
  paused = false;
  hintOn = false;
  $('hint').textContent = '';
  target = Math.floor(Math.random() * places.length);
  monsters = [
    spawnMonster(42, 2),
    spawnMonster(26, 14),
    spawnMonster(42, 26),
    spawnMonster(14, 6),
    spawnMonster(34, 18)
  ];
  running = true;
  $('welcome').style.display = 'none';
  $('pause').textContent = 'Pause';
  setMessage('질문에 나온 장소의 파란 입구(💎)에 닿으면 자동으로 보물을 획득합니다!');
  updateHUD();
}

function straight(blocks) {
  if (!running || paused || ended || move || turn) return;
  let dx = Math.round(Math.sin(yaw)), dz = -Math.round(Math.cos(yaw));
  let tx = px + dx * 4 * blocks, tz = pz + dz * 4 * blocks;
  if (tx < 2 || tx > 42 || tz < 2 || tz > 26) {
    setMessage('마을 경계입니다. Turn left 또는 Turn right로 방향을 바꿔 주세요.');
    return;
  }
  move = { tx, tz, dx, dz };
  setMessage('Go straight ' + blocks + (blocks === 1 ? ' block.' : ' blocks.'));
}

function rotate(dir) {
  if (!running || paused || ended || move || turn) return;
  turn = { goal: yaw + dir * Math.PI / 2 };
  setMessage(dir < 0 ? 'Turn left.' : 'Turn right.');
}

function finish(win) {
  ended = true;
  move = null;
  turn = null;
  setMessage(win
    ? '탐험 종료! 지금까지 💎 보물 ' + score + '개를 모았습니다. Restart로 다시 도전하세요.'
    : '목숨을 모두 잃었습니다. Restart로 다시 도전하세요.');
  updateHUD();
}

function search() {
  if (!running || paused || ended || move || turn) return;
  let p = places[target];
  if (Math.hypot(px - p.doorX, pz - p.doorZ) > 1.25) {
    let n = places.find(a => Math.hypot(px - a.doorX, pz - a.doorZ) < 1.25);
    setMessage(n
      ? '여기는 ' + n.name + '입니다. ' + p.name + '의 입구(💎)를 찾아가세요.'
      : '목표 장소(' + p.name + ')의 파란 입구로 이동하면 자동으로 획득됩니다.');
    return;
  }
  collectTreasure();
}

function showHint() {
  if (!running || ended) return;
  hintOn = true;
  let p = places[target], node = nearestNode(px, pz), route = [], x = node.x, z = node.z;
  while (z !== p.doorZ) {
    let nz = z + Math.sign(p.doorZ - z) * 4;
    route.push({ x, z: nz });
    z = nz;
  }
  while (x !== p.doorX) {
    let nx = x + Math.sign(p.doorX - x) * 4;
    route.push({ x: nx, z });
    x = nx;
  }
  let steps = [], heading = ((Math.round(yaw / (Math.PI / 2)) % 4) + 4) % 4, cx = node.x, cz = node.z;
  let runs = [];
  route.forEach(n => {
    let d = n.x > cx ? 1 : n.x < cx ? 3 : n.z > cz ? 2 : 0;
    if (runs.length && runs[runs.length - 1].d === d) runs[runs.length - 1].n++;
    else runs.push({ d, n: 1 });
    cx = n.x;
    cz = n.z;
  });
  runs.forEach(r => {
    let change = (r.d - heading + 4) % 4;
    if (change === 1) steps.push('Turn right.');
    else if (change === 3) steps.push('Turn left.');
    else if (change === 2) steps.push('Turn right. Turn right.');
    steps.push('Go straight ' + r.n + (r.n === 1 ? ' block.' : ' blocks.'));
    heading = r.d;
  });
  let side = heading === 0 || heading === 1 ? 'right' : 'left';
  let index = target % 10, near = places[target + (index < 9 ? 1 : -1)];
  $('hint').textContent = (steps.length ? steps.join(' ') : 'You are at the entrance.')
    + " It's on your " + side + ". It's next to the " + near.name + ".";
}

function tick(t) {
  let dt = Math.min((t - last) / 1000, 0.04);
  last = t;
  if (running && !paused && !ended) {
    invincible = Math.max(0, invincible - dt);
    if (turn) {
      let diff = turn.goal - yaw, step = dt * 3.8;
      if (Math.abs(diff) <= step) {
        yaw = turn.goal;
        turn = null;
        if (hintOn) showHint();
      } else {
        yaw += Math.sign(diff) * step;
      }
    }
    if (move) {
      let dist = Math.hypot(move.tx - px, move.tz - pz), step = dt * 3.1;
      if (dist <= step) {
        px = move.tx;
        pz = move.tz;
        move = null;
        checkAutoCollect();
        if (hintOn) showHint();
      } else {
        px += move.dx * step;
        pz += move.dz * step;
        checkAutoCollect();
      }
      broadcastState('move');
    }
    monsters.forEach(m => {
      let dx = m.tx - m.x, dz = m.tz - m.z, dist = Math.hypot(dx, dz);
      let step = dt * 0.92 * (1 + score * 0.18);
      if (dist <= step) {
        monsterNext(m);
      } else {
        m.x += dx / dist * step;
        m.z += dz / dist * step;
      }
      if (invincible === 0 && Math.hypot(m.x - px, m.z - pz) < 0.68) {
        lives--;
        invincible = 3.5;
        setMessage('귀신·괴물과 마주쳤습니다! 목숨이 1개 줄었습니다. 3.5초 동안 무적이니 피하세요.');
        if (lives <= 0) finish(false);
      }
    });
    updateHUD();
  }
  $('flash').style.borderWidth = invincible > 3 ? '7px' : '0';
  updateSound();
  draw(t);
  requestAnimationFrame(tick);
}

// Same-Room Multiplayer Sync via BroadcastChannel (works across tabs/windows without external server)
const clientId = 'p_' + Math.random().toString(36).slice(2, 9);
function setupRoomChannel(code) {
  if (bc) {
    try { bc.close(); } catch (e) {}
    bc = null;
  }
  peers = {};
  if (!code || typeof BroadcastChannel === 'undefined') return;
  try {
    bc = new BroadcastChannel('treasure_town_room_' + code.toUpperCase());
    bc.onmessage = ev => {
      const d = ev.data;
      if (!d || d.id === clientId) return;
      if (d.type === 'move') {
        peers[d.id] = { x: d.x, z: d.z, yaw: d.yaw, name: d.name, avatar: d.avatar, score: d.score, ts: performance.now() };
      } else if (d.type === 'collect' && running && !ended) {
        setMessage('친구(' + d.name + ')가 보물을 획득했습니다!');
      }
    };
  } catch (e) {}
}

function broadcastState(type, extra = {}) {
  if (!bc || !student) return;
  try {
    bc.postMessage({
      type,
      id: clientId,
      name: student.name,
      avatar: selected,
      x: px,
      z: pz,
      yaw,
      score,
      ...extra
    });
  } catch (e) {}
}

// Audio Engine (Eerie Proximity Ghost Sound + Treasure Chime)
let audio = null, master = null, voiceGain = null, noiseGain = null, audioFailed = false;
function initAudio() {
  try {
    if (!audio) {
      const A = window.AudioContext || window.webkitAudioContext;
      if (!A) throw new Error('no audio');
      audio = new A();
      master = audio.createGain();
      master.gain.value = Number($('volume').value) / 100;
      master.connect(audio.destination);

      voiceGain = audio.createGain();
      voiceGain.gain.value = 0;
      voiceGain.connect(master);

      const osc = audio.createOscillator();
      osc.type = 'sawtooth';
      osc.frequency.value = 142;
      const filter = audio.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = 420;
      filter.Q.value = 2.4;
      osc.connect(filter);
      filter.connect(voiceGain);
      osc.start();

      const lfo = audio.createOscillator(), lg = audio.createGain();
      lfo.frequency.value = 4.8;
      lg.gain.value = 26;
      lfo.connect(lg);
      lg.connect(osc.frequency);
      lfo.start();

      const b = audio.createBuffer(1, audio.sampleRate * 2, audio.sampleRate);
      const data = b.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = Math.random() * 2 - 1;
      const noise = audio.createBufferSource();
      noise.buffer = b;
      noise.loop = true;
      const nf = audio.createBiquadFilter();
      nf.type = 'bandpass';
      nf.frequency.value = 760;
      nf.Q.value = 0.9;
      noiseGain = audio.createGain();
      noiseGain.gain.value = 0;
      noise.connect(nf);
      nf.connect(noiseGain);
      noiseGain.connect(master);
      noise.start();
    }
    if (audio.state === 'suspended') {
      audio.resume().catch(() => {
        audioFailed = true;
        $('soundState').textContent = '소리를 켜려면 소리 버튼을 눌러 주세요.';
      });
    }
  } catch (e) {
    audioFailed = true;
    $('soundState').textContent = '이 브라우저는 소리를 지원하지 않습니다.';
  }
}

function playChime() {
  if (!audio || !master || $('soundToggle').getAttribute('aria-pressed') !== 'true') return;
  try {
    const now = audio.currentTime;
    [523.25, 659.25, 783.99].forEach((freq, idx) => {
      const o = audio.createOscillator();
      const g = audio.createGain();
      o.type = 'triangle';
      o.frequency.value = freq;
      g.gain.setValueAtTime(0.14, now + idx * 0.07);
      g.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.07 + 0.25);
      o.connect(g);
      g.connect(master);
      o.start(now + idx * 0.07);
      o.stop(now + idx * 0.07 + 0.26);
    });
  } catch (e) {}
}

function updateSound() {
  let distance = Infinity;
  if (running && !paused && !ended && !document.hidden) {
    monsters.forEach(m => {
      distance = Math.min(distance, Math.hypot(m.x - px, m.z - pz));
    });
  }
  const nearby = distance <= 4;
  $('danger').hidden = !nearby;
  if (!audio) return;
  const intensity = nearby ? Math.min(1, 0.24 + (4 - distance) / 4) : 0;
  const enabled = $('soundToggle').getAttribute('aria-pressed') === 'true';
  master.gain.setTargetAtTime(enabled ? Number($('volume').value) / 100 : 0, audio.currentTime, 0.06);
  voiceGain.gain.setTargetAtTime(intensity * 0.13, audio.currentTime, 0.12);
  noiseGain.gain.setTargetAtTime(intensity * 0.04, audio.currentTime, 0.12);
  if (!audioFailed) {
    $('soundState').textContent = enabled
      ? (nearby ? '주의! 귀신·괴물이 1블록 이내에 있습니다.' : '소리가 켜져 있습니다.')
      : '소리가 꺼져 있습니다.';
  }
}

// Event Listeners (Both Panel Buttons & Translucent On-Screen Overlay Buttons)
$('start').onclick = () => { initAudio(); restart(); };
$('reset').onclick = restart;
$('left').onclick = () => rotate(-1);
$('right').onclick = () => rotate(1);
$('hudLeft').onclick = () => rotate(-1);
$('hudRight').onclick = () => rotate(1);
$('hudForward1').onclick = () => straight(1);
$('hudForward2').onclick = () => straight(2);
$('hudForward3').onclick = () => straight(3);
$('search').onclick = search;
